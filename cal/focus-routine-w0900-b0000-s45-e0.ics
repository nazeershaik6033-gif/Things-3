BEGIN:VEVENT
UID:clarity-routine-sprint-morning@clarity.focus
DTSTAMP:20260101T000000Z
DTSTART:20260101T110000
DTEND:20260101T114500
RRULE:FREQ=DAILY
SUMMARY:🎯 Focus Sprint — MIT #1
DESCRIPTION:In 5 min: open Clarity → Focus Sprint.\n1 Schedule (done) · 
 2 Define the next action · 3 Phone out of reach\, close tabs\, clear desk
  · 4 Visible timer 45 min · 5 Record\, next action\, step away.\nStuck? 
 Reset: work deliberately → step away → return fresh.
TRANSP:OPAQUE
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:🎯 Focus Sprint — MIT #1 in 5 min — phone away\, close ta
 bs.
TRIGGER:-PT5M
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Sprint over: record what you did\, note the next action\, step 
 away.
TRIGGER:PT45M
END:VALARM
END:VEVENT
